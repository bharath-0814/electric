# Evora Platform Environment Configuration

# Turso SQL Edge Database (LibSQL)
# Get from https://turso.tech
VITE_TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
VITE_TURSO_AUTH_TOKEN="your_turso_auth_token"

# Firebase Authentication (Console)
# Get from https://console.firebase.google.com
VITE_FIREBASE_API_KEY="your_firebase_api_key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-id"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789"
VITE_FIREBASE_APP_ID="1:123456789:web:abcdef"

# Optional TomTom EV API Key
# Get from https://developer.tomtom.com
VITE_TOMTOM_API_KEY=""

# Optional Open Charge Map API Key
# Get from https://openchargemap.org/site/develop/api
VITE_OCM_API_KEY=""
